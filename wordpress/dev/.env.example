# Gate 0 is local/disposable. Copy to wordpress/dev/.env and change if desired.
ROSA_WP_PORT=8088
ROSA_WP_DB_NAME=rosa_gate0
ROSA_WP_DB_USER=rosa
ROSA_WP_DB_PASSWORD=rosa-local-only
ROSA_WP_DB_ROOT_PASSWORD=rosa-root-local-only
ROSA_WP_DEBUG=1

# Free-first is the default. Change to "pro" only for a controlled comparison.
ROSA_GATE0_MODE=free

# Keep proprietary ZIPs OUTSIDE Git and point to them from the shell environment.
# ROSA_MEDICASHOP_KIT_ZIP=/absolute/path/to/medicashop.zip
# ROSA_ELEMENTOR_PRO_ZIP=/absolute/path/to/elementor-pro.zip
