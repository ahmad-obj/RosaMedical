# Rosa WordPress foundation is local/disposable.
# Copy this file to wordpress/dev/.env and change values only for local development.
ROSA_WP_PORT=8088
ROSA_WP_DB_NAME=rosa_gate0
ROSA_WP_DB_USER=rosa
ROSA_WP_DB_PASSWORD=rosa-local-only
ROSA_WP_DB_ROOT_PASSWORD=rosa-root-local-only
ROSA_WP_DEBUG=1

# No MedicaShop, Elementor Pro, WPML, licence key, or proprietary archive is required
# by the active free-foundation workflow.
