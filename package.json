{
  "name": "rosa-medical",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @rosa/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @rosa/web test:e2e",
    "contracts:generate": "pnpm --filter @rosa/contracts generate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}